diff --git a/test_todo.py b/test_todo.py
new file mode 100644
index 0000000000000000000000000000000000000000..fecb13e2c6126f4d25173c836251cc7490c51c90
--- /dev/null
+++ b/test_todo.py
@@ -0,0 +1,52 @@
+import json
+
+from todo import TodoList
+
+
+def test_add(tmp_path):
+    path = tmp_path / "todos.json"
+    todos = TodoList(path)
+
+    todos.add("Buy milk")
+    todos.add("Walk the dog")
+
+    assert todos.list_items() == [
+        (0, "Buy milk", False),
+        (1, "Walk the dog", False),
+    ]
+    assert json.loads(path.read_text(encoding="utf-8")) == [
+        {"text": "Buy milk", "done": False},
+        {"text": "Walk the dog", "done": False},
+    ]
+
+
+def test_complete(tmp_path):
+    todos = TodoList(tmp_path / "todos.json")
+    todos.add("Finish report")
+
+    todos.complete(0)
+
+    assert todos.list_items() == [(0, "Finish report", True)]
+
+
+def test_remove_reindexes_remaining_items(tmp_path):
+    todos = TodoList(tmp_path / "todos.json")
+    todos.add("First")
+    todos.add("Second")
+
+    todos.remove(0)
+
+    assert todos.list_items() == [(0, "Second", False)]
+
+
+def test_persistence_across_reload(tmp_path):
+    path = tmp_path / "todos.json"
+    original = TodoList(path)
+    original.add("Persist me")
+    original.add("Remove me")
+    original.complete(0)
+    original.remove(1)
+
+    reloaded = TodoList(path)
+
+    assert reloaded.list_items() == [(0, "Persist me", True)]
diff --git a/todo.py b/todo.py
new file mode 100644
index 0000000000000000000000000000000000000000..7efdaec905233b7ae486eda71040bc1b6f62ad72
--- /dev/null
+++ b/todo.py
@@ -0,0 +1,113 @@
+"""A small persistent to-do list and command-line interface."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Sequence
+
+
+class TodoList:
+    """A to-do list persisted as JSON after every mutation."""
+
+    def __init__(self, filename: str | Path = "todo.json") -> None:
+        self.filename = Path(filename)
+        self._items: list[dict[str, object]] = []
+        self._load()
+
+    def _load(self) -> None:
+        if not self.filename.exists():
+            return
+
+        with self.filename.open(encoding="utf-8") as file:
+            data = json.load(file)
+
+        if not isinstance(data, list):
+            raise ValueError("todo file must contain a JSON list")
+
+        items: list[dict[str, object]] = []
+        for item in data:
+            if (
+                not isinstance(item, dict)
+                or not isinstance(item.get("text"), str)
+                or not isinstance(item.get("done"), bool)
+            ):
+                raise ValueError("todo file contains an invalid item")
+            items.append({"text": item["text"], "done": item["done"]})
+        self._items = items
+
+    def _save(self) -> None:
+        self.filename.parent.mkdir(parents=True, exist_ok=True)
+        with self.filename.open("w", encoding="utf-8") as file:
+            json.dump(self._items, file, indent=2, ensure_ascii=False)
+            file.write("\n")
+
+    def _item_at(self, index: int) -> dict[str, object]:
+        if not isinstance(index, int) or isinstance(index, bool):
+            raise TypeError("index must be an integer")
+        if index < 0 or index >= len(self._items):
+            raise IndexError("todo index out of range")
+        return self._items[index]
+
+    def add(self, text: str) -> None:
+        """Add an incomplete item and persist the list."""
+        if not isinstance(text, str):
+            raise TypeError("text must be a string")
+        self._items.append({"text": text, "done": False})
+        self._save()
+
+    def complete(self, index: int) -> None:
+        """Mark the item at *index* complete and persist the list."""
+        self._item_at(index)["done"] = True
+        self._save()
+
+    def remove(self, index: int) -> None:
+        """Remove the item at *index* and persist the list."""
+        self._item_at(index)
+        del self._items[index]
+        self._save()
+
+    def list_items(self) -> list[tuple[int, str, bool]]:
+        """Return ``(index, text, done)`` tuples in list order."""
+        return [
+            (index, str(item["text"]), bool(item["done"]))
+            for index, item in enumerate(self._items)
+        ]
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="Manage a persistent to-do list")
+    parser.add_argument("--file", default="todo.json", help="JSON storage path")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    add_parser = subparsers.add_parser("add", help="add an item")
+    add_parser.add_argument("text")
+
+    for command in ("complete", "remove"):
+        command_parser = subparsers.add_parser(command, help=f"{command} an item")
+        command_parser.add_argument("index", type=int)
+
+    subparsers.add_parser("list", help="list items")
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _build_parser().parse_args(argv)
+    todos = TodoList(args.file)
+
+    if args.command == "add":
+        todos.add(args.text)
+    elif args.command == "complete":
+        todos.complete(args.index)
+    elif args.command == "remove":
+        todos.remove(args.index)
+    else:
+        for index, text, done in todos.list_items():
+            marker = "x" if done else " "
+            print(f"{index}: [{marker}] {text}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

