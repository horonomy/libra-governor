+            file.write("\n")
+
+    def _item_at(self, index: int) -> dict[str, object]:
+        if not isinstance(index, int) or isinstance(index, bool):
+            raise TypeError("index must be an integer")
+        if index < 0 or index >= len(self._items):
+            raise IndexError("todo index out of range")
+        return self._items[index]
+
+    def add(self, text: str) -> None:
+        """Add an incomplete item and persist the list."""
+        if not isinstance(text, str):
+            raise TypeError("text must be a string")
+        self._items.append({"text": text, "done": False})
+        self._save()
+
+    def complete(self, index: int) -> None:
+        """Mark the item at *index* complete and persist the list."""
+        self._item_at(index)["done"] = True
+        self._save()
+
+    def remove(self, index: int) -> None:
+        """Remove the item at *index* and persist the list."""
+        self._item_at(index)
+        del self._items[index]
+        self._save()
+
+    def list_items(self) -> list[tuple[int, str, bool]]:
+        """Return ``(index, text, done)`` tuples in list order."""
+        return [
+            (index, str(item["text"]), bool(item["done"]))
+            for index, item in enumerate(self._items)
+        ]
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description="Manage a persistent to-do list")
+    parser.add_argument("--file", default="todo.json", help="JSON storage path")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    add_parser = subparsers.add_parser("add", help="add an item")
+    add_parser.add_argument("text")
+
+    for command in ("complete", "remove"):
+        command_parser = subparsers.add_parser(command, help=f"{command} an item")
+        command_parser.add_argument("index", type=int)
+
+    subparsers.add_parser("list", help="list items")
+    return parser
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _build_parser().parse_args(argv)
+    todos = TodoList(args.file)
+
+    if args.command == "add":
+        todos.add(args.text)
+    elif args.command == "complete":
+        todos.complete(args.index)
+    elif args.command == "remove":
+        todos.remove(args.index)
+    else:
+        for index, text, done in todos.list_items():
+            marker = "x" if done else " "
+            print(f"{index}: [{marker}] {text}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

