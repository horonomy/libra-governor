+        code = self._encode(next_id)
+        while code in self._urls:
+            next_id += 1
+            code = self._encode(next_id)
+
+        self._urls[code] = long_url
+        self._codes_by_url[long_url] = code
+        self._save()
+        return code
+
+    def resolve(self, code: str) -> str | None:
+        """Return the original URL for *code*, or ``None`` if it is unknown."""
+        return self._urls.get(code)
+
+    def _load(self) -> dict[str, str]:
+        if not self.storage_path.exists():
+            return {}
+        with self.storage_path.open(encoding="utf-8") as file:
+            data = json.load(file)
+        if not isinstance(data, dict) or not all(
+            isinstance(code, str) and isinstance(url, str)
+            for code, url in data.items()
+        ):
+            raise ValueError("URL storage must be a JSON object of string mappings")
+        return data
+
+    def _save(self) -> None:
+        self.storage_path.parent.mkdir(parents=True, exist_ok=True)
+        descriptor, temporary_name = tempfile.mkstemp(
+            dir=self.storage_path.parent,
+            prefix=f".{self.storage_path.name}.",
+            text=True,
+        )
+        try:
+            with os.fdopen(descriptor, "w", encoding="utf-8") as file:
+                json.dump(self._urls, file, indent=2, sort_keys=True)
+                file.write("\n")
+            os.replace(temporary_name, self.storage_path)
+        except BaseException:
+            try:
+                os.unlink(temporary_name)
+            except FileNotFoundError:
+                pass
+            raise
+
+    @classmethod
+    def _encode(cls, number: int) -> str:
+        encoded = ""
+        base = len(cls._ALPHABET)
+        while number:
+            number, remainder = divmod(number, base)
+            encoded = cls._ALPHABET[remainder] + encoded
+        return encoded or cls._ALPHABET[0]
