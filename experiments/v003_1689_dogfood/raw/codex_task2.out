+    storage = tmp_path / "urls.json"
+    url = "https://example.com/persistent"
+    code = Shortener(storage).shorten(url)
+
+    assert Shortener(storage).resolve(code) == url
+    assert json.loads(storage.read_text()) == {code: url}
