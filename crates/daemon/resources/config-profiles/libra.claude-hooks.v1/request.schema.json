{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "target_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "intent": {
      "enum": [
        "install",
        "enable",
        "disable",
        "uninstall"
      ]
    },
    "slots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot": {
            "enum": [
              "prompt_submit",
              "tool_completed",
              "turn_completed"
            ]
          },
          "callback_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "desired": {
            "enum": [
              "present",
              "absent"
            ]
          },
          "observed": {
            "enum": [
              "absent",
              "exact_owned",
              "conflict"
            ]
          },
          "owned_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slot",
          "callback_ref",
          "desired",
          "observed",
          "owned_digest"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "intent",
    "binding_id",
    "installation_id",
    "slots"
  ]
}
