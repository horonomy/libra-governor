{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horonomy.github.io/contracts/host-adapter/v1/canonical-host-event.schema.json",
  "title": "CanonicalHostEvent v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "observed_at", "adapter_id", "adapter_version", "source", "capability_snapshot_id", "identity", "scope", "kind", "facts", "quality", "field_provenance"],
  "properties": {
    "schema_version": {"const": 1}, "event_id": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "adapter_version": {"type": "string", "minLength": 1}, "host_version": {"type": "string"},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind", "native_event_name"], "properties": {"kind": {"enum": ["hook", "rollout", "statusline", "cli", "other"]}, "native_event_name": {"type": "string", "minLength": 1}, "native_schema_ref": {"type": "string"}, "native_event_id": {"type": "string"}, "replay_key": {"type": "string"}}},
    "capability_snapshot_id": {"type": "string", "minLength": 1},
    "identity": {"type": "object", "additionalProperties": true, "required": ["envelope_version", "observed_at", "host_id", "tool_provider", "lineage_status"], "properties": {"envelope_version": {"const": 1}, "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "host_id": {"type": "string", "minLength": 1}, "tool_provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}, "lineage_status": {"enum": ["root", "child", "unknown"]}, "tool_instance_id": {"type": "string"}, "provider_session_id": {"type": "string"}, "agent_id": {"type": "string"}, "turn_id": {"type": "string"}, "parent_agent_id": {"type": "string", "minLength": 1}, "session_lineage_id": {"type": "string"}, "event_id": {"type": "string"}, "repo_id": {"type": "string"}, "worktree_id": {"type": "string"}}, "allOf": [{"if": {"properties": {"lineage_status": {"const": "child"}}}, "then": {"required": ["parent_agent_id"]}}, {"if": {"properties": {"lineage_status": {"enum": ["root", "unknown"]}}}, "then": {"not": {"required": ["parent_agent_id"]}}}]},
    "scope": {"enum": ["host", "session", "agent", "turn_task", "project_worktree", "unknown"]},
    "kind": {"enum": ["lifecycle", "tool_before", "tool_after", "tool_failure", "usage"]}, "facts": {"type": "object"},
    "quality": {"enum": ["literal", "reconstructed", "heuristic"]}, "field_provenance": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "lifecycle"}}}, "then": {"properties": {"facts": {"type": "object", "additionalProperties": false, "required": ["event_type"], "properties": {"event_type": {"enum": ["session_start", "session_end", "turn_start", "turn_end", "subagent_start", "subagent_end", "interrupt", "compact"]}, "native_lifecycle_id": {"type": "string"}}}}}},
    {
      "if": {"properties": {"kind": {"enum": ["tool_before", "tool_after", "tool_failure"]}}},
      "then": {"properties": {"facts": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "tool_name": {"type": "string", "minLength": 1, "description": "Verbatim native tool name; provenance only, not a normalized action."},
          "native_call_id": {"type": "string"},
          "action_kind": {"enum": ["shell_command", "file_mutation", "unknown"]},
          "operand_completeness": {"enum": ["complete", "partial", "unknown"]},
          "working_directory": {"type": "string", "minLength": 1},
          "operands": {"oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["command"], "properties": {"command": {"type": "string", "minLength": 1}}},
            {"type": "object", "additionalProperties": false, "required": ["files"], "properties": {"files": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["operation", "path"],
              "properties": {"operation": {"enum": ["create", "update", "delete", "move"]}, "path": {"type": "string", "minLength": 1}, "destination_path": {"type": "string", "minLength": 1}},
              "allOf": [{"if": {"properties": {"operation": {"const": "move"}}}, "then": {"required": ["destination_path"]}}, {"if": {"properties": {"operation": {"enum": ["create", "update", "delete"]}}}, "then": {"not": {"required": ["destination_path"]}}}]
            }}}}
          ]},
          "operands_availability": {"enum": ["observed", "unavailable", "redacted", "not_provided"]},
          "result_availability": {"enum": ["observed", "unavailable", "redacted", "not_provided"]}, "result": {}, "failure_code": {"type": "string"}
        },
        "required": ["tool_name"],
        "allOf": [
          {"if": {"required": ["action_kind"], "properties": {"action_kind": {"const": "shell_command"}}}, "then": {"properties": {"operands": {"type": "object", "required": ["command"]}}}},
          {"if": {"required": ["action_kind"], "properties": {"action_kind": {"const": "file_mutation"}}}, "then": {"properties": {"operands": {"type": "object", "required": ["files"]}}}},
          {"if": {"required": ["operand_completeness"], "properties": {"operand_completeness": {"const": "complete"}}}, "then": {"required": ["action_kind", "operands", "operands_availability"], "properties": {"action_kind": {"enum": ["shell_command", "file_mutation"]}, "operands_availability": {"const": "observed"}}}},
          {"if": {"required": ["action_kind"], "properties": {"action_kind": {"const": "unknown"}}}, "then": {"properties": {"operand_completeness": {"enum": ["partial", "unknown"]}}, "not": {"required": ["operands"]}}}
        ]
      }}}
    },
    {"if": {"properties": {"kind": {"const": "usage"}}}, "then": {"properties": {"facts": {"type": "object", "additionalProperties": false, "required": ["measure", "amount", "unit", "aggregation", "observation_scope"], "properties": {"measure": {"type": "string", "minLength": 1}, "amount": {"type": "number", "minimum": 0}, "unit": {"type": "string", "minLength": 1}, "aggregation": {"enum": ["delta", "cumulative"]}, "observation_scope": {"enum": ["host", "session", "agent", "turn_task", "project_worktree", "unknown"]}, "model": {"type": "string"}}}}}}
  ]
}
