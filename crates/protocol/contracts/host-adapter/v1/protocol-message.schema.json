{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horonomy.github.io/contracts/host-adapter/v1/protocol-message.schema.json",
  "title": "Host adapter protocol v1 request and response",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"enum": ["unsupported_version", "unsupported_operation", "invalid_input", "unsupported", "failed"]}, "message": {"type": "string", "maxLength": 1024}}},
    "request": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["protocol", "offered_versions", "request_id", "operation"], "properties": {"protocol": {"const": "horonom.host-adapter"}, "offered_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}}, "request_id": {"$ref": "#/$defs/id"}, "operation": {"const": "handshake"}}},
      {"$ref": "#/$defs/operationRequest"}
    ]},
    "operationRequest": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["protocol", "protocol_version", "host_contract_version", "request_id", "operation", "input"], "properties": {"protocol": {"const": "horonom.host-adapter"}, "protocol_version": {"const": 1}, "host_contract_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "operation": {"const": "probe"}, "input": {"$ref": "#/$defs/inputs/probe"}, "configuration": {"type": "object"}}},
      {"type": "object", "additionalProperties": false, "required": ["protocol", "protocol_version", "host_contract_version", "request_id", "operation", "input"], "properties": {"protocol": {"const": "horonom.host-adapter"}, "protocol_version": {"const": 1}, "host_contract_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "operation": {"const": "normalize"}, "input": {"$ref": "#/$defs/inputs/normalize"}, "configuration": {"type": "object"}}},
      {"type": "object", "additionalProperties": false, "required": ["protocol", "protocol_version", "host_contract_version", "request_id", "operation", "input"], "properties": {"protocol": {"const": "horonom.host-adapter"}, "protocol_version": {"const": 1}, "host_contract_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "operation": {"const": "encode_control"}, "input": {"$ref": "#/$defs/inputs/encode_control"}, "configuration": {"type": "object"}}},
      {"type": "object", "additionalProperties": false, "required": ["protocol", "protocol_version", "host_contract_version", "request_id", "operation", "input"], "properties": {"protocol": {"const": "horonom.host-adapter"}, "protocol_version": {"const": 1}, "host_contract_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "operation": {"const": "plan_config"}, "input": {"$ref": "#/$defs/inputs/plan_config"}, "configuration": {"type": "object"}}}
    ]},
    "response": {"oneOf": [
      {"type": "object", "required": ["protocol", "request_id", "selected_version"], "not": {"anyOf": [{"required": ["protocol_version"]}, {"required": ["host_contract_version"]}, {"required": ["result"]}, {"required": ["error"]}]}, "properties": {"protocol": {"const": "horonom.host-adapter"}, "request_id": {"$ref": "#/$defs/id"}, "selected_version": {"const": 1}}},
      {"type": "object", "required": ["protocol", "request_id", "error"], "not": {"anyOf": [{"required": ["selected_version"]}, {"required": ["protocol_version"]}, {"required": ["host_contract_version"]}, {"required": ["result"]}]}, "properties": {"protocol": {"const": "horonom.host-adapter"}, "request_id": {"$ref": "#/$defs/id"}, "error": {"$ref": "#/$defs/error"}}},
      {"type": "object", "required": ["protocol", "request_id", "protocol_version", "host_contract_version", "result"], "not": {"anyOf": [{"required": ["selected_version"]}, {"required": ["error"]}]}, "properties": {"protocol": {"const": "horonom.host-adapter"}, "request_id": {"$ref": "#/$defs/id"}, "protocol_version": {"const": 1}, "host_contract_version": {"const": 1}, "result": {"type": "object"}}},
      {"type": "object", "required": ["protocol", "request_id", "protocol_version", "host_contract_version", "error"], "not": {"anyOf": [{"required": ["selected_version"]}, {"required": ["result"]}]}, "properties": {"protocol": {"const": "horonom.host-adapter"}, "request_id": {"$ref": "#/$defs/id"}, "protocol_version": {"const": 1}, "host_contract_version": {"const": 1}, "error": {"$ref": "#/$defs/error"}}}
    ]},
    "snapshotContext": {"type": "object", "additionalProperties": false, "required": ["scope"], "properties": {"scope": {"enum": ["host", "session", "agent", "turn_task", "project_worktree", "unknown"]}, "profile": {"type": "string"}, "project_ref": {"type": "string"}}},
    "eventSource": {"type": "object", "additionalProperties": false, "required": ["kind", "native_event_name"], "properties": {"kind": {"enum": ["hook", "rollout", "statusline", "cli", "other"]}, "native_event_name": {"type": "string", "minLength": 1}, "native_schema_ref": {"type": "string"}, "native_event_id": {"type": "string"}, "replay_key": {"type": "string"}}},
    "validatorRef": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "integer", "minimum": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "controlIntent": {"type": "object", "additionalProperties": false, "required": ["schema_version", "request_id", "event_id", "product_id", "decision_ref", "action", "required_capability_keys", "required_failure_class"], "properties": {"schema_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "event_id": {"$ref": "#/$defs/id"}, "product_id": {"type": "string", "minLength": 1, "maxLength": 128}, "decision_ref": {"type": "string", "minLength": 1, "maxLength": 256}, "action": {"enum": ["allow", "deny", "rewrite", "request_approval"]}, "required_capability_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}}, "required_failure_class": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*\\.[a-z][a-z0-9_.-]*$"}, "rewrite_input": {"type": "object"}}, "allOf": [{"if": {"properties": {"action": {"const": "rewrite"}}, "required": ["action"]}, "then": {"required": ["rewrite_input"]}}, {"if": {"properties": {"action": {"enum": ["allow", "deny", "request_approval"]}}, "required": ["action"]}, "then": {"not": {"required": ["rewrite_input"]}}}]},
    "controlEncodingResult": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["schema_version", "status", "event_id", "action", "native_response", "delivery"], "properties": {"schema_version": {"const": 1}, "status": {"const": "encoded"}, "event_id": {"$ref": "#/$defs/id"}, "action": {"enum": ["allow", "deny", "rewrite", "request_approval"]}, "native_response": {"type": "object"}, "delivery": {"const": "encoded"}}},
      {"type": "object", "additionalProperties": false, "required": ["schema_version", "status", "event_id", "action", "reason_code", "delivery"], "properties": {"schema_version": {"const": 1}, "status": {"const": "unsupported"}, "event_id": {"$ref": "#/$defs/id"}, "action": {"enum": ["allow", "deny", "rewrite", "request_approval"]}, "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}, "delivery": {"const": "not_attempted"}}}
    ]},
    "inputs": {
      "probe": {"type": "object", "additionalProperties": false, "required": ["context"], "properties": {"context": {"$ref": "#/$defs/snapshotContext"}}},
      "normalize": {"type": "object", "additionalProperties": false, "required": ["native_payload", "source", "host_id", "observed_at", "capability_snapshot"], "properties": {"native_payload": {"type": "object"}, "source": {"$ref": "#/$defs/eventSource"}, "host_id": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "capability_snapshot": {"$ref": "https://horonomy.github.io/contracts/host-adapter/v1/host-capability-snapshot.schema.json"}}},
      "encode_control": {"type": "object", "additionalProperties": false, "required": ["intent", "event", "capability_snapshot"], "properties": {"intent": {"$ref": "#/$defs/controlIntent"}, "event": {"$ref": "https://horonomy.github.io/contracts/host-adapter/v1/canonical-host-event.schema.json"}, "capability_snapshot": {"$ref": "https://horonomy.github.io/contracts/host-adapter/v1/host-capability-snapshot.schema.json"}}},
      "plan_config": {"type": "object", "additionalProperties": false, "required": ["product_id", "validator_ref", "context", "request"], "properties": {"product_id": {"type": "string", "minLength": 1}, "validator_ref": {"$ref": "#/$defs/validatorRef"}, "context": {"$ref": "#/$defs/snapshotContext"}, "request": {"type": "object"}}}
    },
    "results": {
      "probe": {"type": "object", "additionalProperties": false, "required": ["snapshot"], "properties": {"snapshot": {"$ref": "https://horonomy.github.io/contracts/host-adapter/v1/host-capability-snapshot.schema.json"}}},
      "normalize": {"type": "object", "additionalProperties": false, "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "items": {"$ref": "https://horonomy.github.io/contracts/host-adapter/v1/canonical-host-event.schema.json"}}}},
      "encode_control": {"$ref": "#/$defs/controlEncodingResult"},
      "plan_config": {"type": "object", "additionalProperties": false, "required": ["product_id", "validator_ref", "plan"], "properties": {"product_id": {"type": "string", "minLength": 1}, "validator_ref": {"$ref": "#/$defs/validatorRef"}, "plan": {"type": "object"}}}
    }
  }
}
